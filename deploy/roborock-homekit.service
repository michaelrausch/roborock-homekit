[Unit]
Description=Roborock HomeKit bridge
Documentation=file:///opt/roborock-homekit/README.md
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=roborock-homekit
Group=roborock-homekit
ExecStart=/opt/roborock-homekit/bin/roborock-homekit run
Environment=PYTHONUNBUFFERED=1
# Retry if the network or Roborock cloud isn't reachable yet (e.g. right after boot).
Restart=on-failure
RestartSec=30

# Creates /var/lib/roborock-homekit owned by the service user.
StateDirectory=roborock-homekit
StateDirectoryMode=0700

# Hardening: the service only needs its state directory and the network.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
